# Hair/mesh asset formats: never normalize line endings or diff as text.
*.tfx binary
*.tfxbone binary
*.tfxmesh binary
*.bin binary
*.glb binary

# Built extension DLLs (committed so a fresh clone can F5 without a C++
# toolchain): stored in Git LFS. Only the DLL the manifest points at is
# force-added (`git add -f`); stale timestamped builds stay ignored.
demo/bin/*.dll filter=lfs diff=lfs merge=lfs -text
*.blend binary
*.ghair binary
